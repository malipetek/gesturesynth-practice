---
import "../styles/global.css";

interface Props {
	title: string;
	description?: string;
	/** Override the canonical URL. Defaults to this page's URL on the production site. */
	canonical?: string;
	/** Open Graph type, e.g. "website" (default) or "article". */
	ogType?: string;
	ogImage?: string;
	/** Extra JSON-LD objects to inject, merged with the site-wide WebSite schema. */
	jsonLd?: object[];
	/** Render <meta name="robots" content="noindex"> (unused pages / drafts). */
	noindex?: boolean;
}

const {
	title,
	description = "Learn to play songs on Gesture Synth, one chord gesture at a time.",
	canonical,
	ogType = "website",
	ogImage = "/og-image.png",
	jsonLd = [],
	noindex = false,
} = Astro.props;

const canonicalUrl = canonical ?? new URL(Astro.url.pathname, Astro.site).href;
const ogImageUrl = new URL(ogImage, Astro.site).href;

const schema = [
	{
		"@context": "https://schema.org",
		"@type": "WebSite",
		name: "Gesture Synth School",
		alternateName: "Gesture Synth Practice",
		url: Astro.site.href,
		description:
			"Learn to play songs on Gesture Synth with guided practice charts.",
		inLanguage: "en",
	},
	...jsonLd,
];
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="robots" content={noindex ? "noindex" : "index, follow"} />
		<link rel="canonical" href={canonicalUrl} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
		<link rel="icon" href="/favicon.ico" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;600;700&family=Syne:wght@600;700;800&display=swap"
			rel="stylesheet"
		/>

		<title>{title}</title>

		<meta property="og:type" content={ogType} />
		<meta property="og:site_name" content="Gesture Synth School" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:image" content={ogImageUrl} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageUrl} />

		<script type="application/ld+json" set:html={JSON.stringify(schema)} />

		<script
			async
			src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-4049499068282753"
			crossorigin="anonymous"></script>
	</head>
	<body>
		<header class="site-header">
			<div class="container">
				<a class="brand" href="/">
					<img src="/logo-icon.svg" alt="" width="32" height="32" />
					<span>Gesture Synth School</span>
				</a>
			</div>
		</header>
		<main>
			<slot />
		</main>
		<footer class="site-footer">
			<div class="container">
				<p class="muted">
					Practice every chord gesture until it feels like second nature.
				</p>
				<nav class="footer-links">
					<a class="muted" href="/guide/">How to play</a>
					<a class="muted" href="/chords/">Chord gestures</a>
					<a class="muted" href="/weld/">Gesture Synth Weld</a>
					<a class="muted" href="/">Songbook</a>
				</nav>
				<a
					class="btn feedback-btn"
					href="mailto:feedback@gesturesynthschool.com">Send feedback</a
				>
				<a class="muted" href="https://www.gesturesynth.com"
					>Powered by Gesture Synth</a
				>
			</div>
		</footer>
	</body>
</html>
