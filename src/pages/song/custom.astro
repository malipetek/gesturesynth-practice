---
import Layout from '../../layouts/Layout.astro';
import CustomSong from '../../components/CustomSong';
---

<Layout
	title="Your song | Gesture Synth Practice"
	description="Practice your own imported song on Gesture Synth."
	noindex
>
	<section class="song-header container">
		<a class="back muted" href="/">&#8592; Songbook</a>
		<h1 class="visually-hidden">Your song</h1>
	</section>

	<section class="song-stage container">
		<CustomSong client:only="react" />
	</section>
</Layout>
