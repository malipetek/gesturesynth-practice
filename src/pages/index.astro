---
import Layout from "../layouts/Layout.astro";
import CustomSongList from "../components/CustomSongList";
import { getSongs } from "../lib/songs";
import type { Song } from "../lib/types";

// Editorial order first (hit pieces up top), then everything else by title.
const songList = [...getSongs()].sort(
	(a, b) =>
		(a.order ?? 1000) - (b.order ?? 1000) || a.title.localeCompare(b.title),
);

const barCount = (song: Song) =>
	song.events.reduce((max, e) => Math.max(max, e.bar), 0);
---

<Layout
	title="Learn Gesture Synth: Play Songs with Hand Gestures | Gesture Synth School"
	description="Free guided practice for Gesture Synth. Chord charts, gesture tutorials, and a play-along player for popular songs — learn the hand gestures step by step."
	jsonLd={[
		{
			"@context": "https://schema.org",
			"@type": "SoftwareApplication",
			name: "Gesture Synth School",
			applicationCategory: "EducationalApplication",
			operatingSystem: "Web",
			description:
				"Guided practice player for Gesture Synth with chord charts, gesture tutorials, and a webcam hand-tracking songbook.",
			offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
			url: Astro.site.href,
		},
	]}
>
	<section class="hero container">
		<p class="eyebrow">Gesture Synth</p>
		<h1>Practice</h1>
		<p>Learn to play songs on Gesture Synth, one chord gesture at a time.</p>
		<div class="hero-links">
			<a class="btn" href="/guide/">How to play</a>
			<a class="btn" href="/chords/">Chord gestures</a>
		</div>
	</section>

	<section class="intro container">
		<p>
			Gesture Synth turns your webcam into a musical instrument: your left hand picks the
			scale degree and major or minor key, your right hand shapes the chord quality and
			octave. The songbook below turns that gesture language into playable charts — each
			song shows the exact hand shape for every chord, and the play-along player scores you
			against each target with a backing pad and metronome. New to the instrument?
			<a href="/guides/first-song/">Start with our guide to picking your first song</a>.
		</p>
	</section>

	<section class="steps container">
		<h2 class="muted">How it works</h2>
		<div class="grid grid-3">
			<div class="card step">
				<span class="step-num">Left hand</span>
				<h3>Pick a scale degree</h3>
				<p class="muted">
					Raise 1–5 fingers for degrees I–V; index + pinky for VI, add the thumb
					for VII. Tilt your wrist to flip between major and minor.
				</p>
			</div>
			<div class="card step">
				<span class="step-num">Right hand</span>
				<h3>Shape the chord</h3>
				<p class="muted">
					1–4 fingers choose the chord quality, and your thumb shifts the octave
					up or down.
				</p>
			</div>
			<div class="card step">
				<span class="step-num">Match both</span>
				<h3>Follow the chart</h3>
				<p class="muted">
					Line both hands up to the target shape for each chord in the chart and
					the song rings out.
				</p>
			</div>
		</div>
	</section>

	<section class="tools container">
		<div class="grid grid-2">
			<a class="action-tile" href="/freeform">
				<span class="action-glyph" aria-hidden="true">&#119070;</span>
				<span class="action-body">
					<span class="action-title">Freeform instrument</span>
					<span class="action-sub"
						>The gesturesynth.com instrument — play anything, any key</span
					>
				</span>
				<span class="action-arrow" aria-hidden="true">&rarr;</span>
			</a>
			<a class="action-tile" href="/import">
				<span class="action-glyph" aria-hidden="true">&#43;</span>
				<span class="action-body">
					<span class="action-title">Add your own song</span>
					<span class="action-sub"
						>Paste ChordPro chords — saved in this browser</span
					>
				</span>
				<span class="action-arrow" aria-hidden="true">&rarr;</span>
			</a>
		</div>
	</section>

	<CustomSongList client:only="react" />

	<section class="guides container">
		<div class="songbook-head">
			<h2>Guides</h2>
		</div>
		<div class="grid grid-3">
			<a class="card guide-card" href="/guides/first-song/">
				<h3>How to pick your first song</h3>
				<p class="muted">
					A simple framework for matching a chart to your skill level, with specific
					recommendations from the songbook.
				</p>
			</a>
			<a class="card guide-card" href="/guides/playing-in-time/">
				<h3>Playing in time</h3>
				<p class="muted">
					Three stages of drills for hitting every chord exactly on the beat — the skill
					that makes it sound like playing.
				</p>
			</a>
			<a class="card guide-card" href="/guides/">
				<h3>All songs by difficulty</h3>
				<p class="muted">
					Every song in the book rated Beginner to Advanced, with the reason why.
				</p>
			</a>
		</div>
	</section>

	<section class="songbook container">
		<div class="songbook-head">
			<h2>Songbook</h2>
			<span class="song-count"
				>{songList.length} {songList.length === 1 ? "song" : "songs"}</span
			>
		</div>
		{
			songList.length === 0 ? (
				<div class="empty">
					<span class="glyph">&#9834;</span>
					<h3>No songs yet</h3>
					<p>
						Songs will appear here once the songbook is ready. Check back soon.
					</p>
				</div>
			) : (
				<div class="grid grid-auto">
					{songList.map((song) => (
						<a class="card song-card" href={`/song/${song.slug}`}>
							<div class="song-card-head">
								<p class="song-title">{song.title}</p>
								<span class="key-chip">{song.key}</span>
							</div>
							<p class="song-artist">{song.artist}</p>
							<p class="song-meta-line">
								{song.bpm} BPM · {barCount(song)} bars · {song.events.length}{" "}
								chords
							</p>
						</a>
					))}
				</div>
			)
		}
	</section>
</Layout>
